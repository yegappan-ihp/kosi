OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
KOSI_LLM_BACKEND=openai
KOSI_DETECTOR_MODE=yolo
YOLO_MODEL=yolov8s-world.pt
YOLO_CONFIDENCE=0.25
CROP_PADDING_RATIO=0.15
KOSI_OUTPUT_DIR=output_files
KOSI_REPLY_DIR=reply
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_IMAGE_SIDE=1800
OPENAI_CONCURRENCY=2
KOSI_STEP_WORKERS=3
KOSI_MAX_STEP_TARGETS=4
KOSI_EVERYTHING_MAX_TAGS=24
RAM_CHECKPOINT_PATH=

# Used only when KOSI_LLM_BACKEND=local
LOCAL_VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
